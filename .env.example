# 기존 AccessNavWeb 프로젝트와 동일한 변수명을 사용합니다.
APP_NAME=go-lego-agent
APP_ENV=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

DATABASE_ENABLED=true

MAPSERVICE_DB_HOST=127.0.0.1
MAPSERVICE_DB_PORT=3306
MAPSERVICE_DB_USER=root
MAPSERVICE_DB_PASSWORD=여기에_MySQL_비밀번호
MAPSERVICE_DB_NAME=barrier_free_db

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

GOLEGO_BACKEND_BASE_URL=http://127.0.0.1:3000
ROUTE_API_TIMEOUT_SECONDS=10

MAX_AGENT_MESSAGE_LENGTH=200

# 아래 변수는 현재 Agent MVP에서 직접 사용하지 않지만,
# 기존 프로젝트와의 환경변수 호환성을 위해 유지합니다.
KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
ORS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
KIOSK_API_URL=
DATA_GO_KR_SERVICE_KEY=
TAXI_STAND_API_URL=
MAPSERVICE_PROJECT_DIR=
MAPSERVICE_BASE_URL=http://localhost:8080
MAPSERVICE_ACCESSIBILITY_REPORTS_ENDPOINT=/api/accessibility-reports
MAPSERVICE_PLACE_ACCESSIBILITY_ENDPOINT=/api/place-accessibility
